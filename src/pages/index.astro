---
import '../styles/global.css';
import '../styles/corridor.css';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="A 2.5D interactive exhibit exploring JMU, Harrisonburg, and Rockingham County through town-gown Darts & Pats from The Breeze." />
    <title>The Breeze Between Town and Gown</title>
  </head>
  <body class="is-attractor-active">
    <a class="skip-link" href="#walk-years">Skip to the Memory Corridor</a>

    <section class="attractor-mode" id="attractor-mode" aria-labelledby="attractor-title" aria-describedby="attractor-desc">
      <div class="attractor-mode__sky">
        <p class="kicker">The Breeze Parade</p>
        <h1 id="attractor-title">The Breeze Parade</h1>
        <p id="attractor-desc">
          Balloons, clippings, town notes, campus echoes. A gentle parade is passing through the archive.
        </p>
        <button class="attractor-mode__enter" id="attractor-enter" type="button">Touch here to enter The Memory Corridor</button>
      </div>

      <div class="attractor-mode__card-layer" id="attractor-card-layer" aria-live="polite"></div>
      <div class="attractor-balloon" id="attractor-balloon" aria-hidden="true">
        <span></span>
      </div>

      <div class="attractor-mode__scene" id="attractor-scene" role="button" tabindex="0" aria-label="Enter the exhibit from The Breeze Parade">
        <div class="attractor-mode__street" aria-hidden="true">
          <div class="attractor-crosswalk"></div>
          <div class="attractor-storefronts">
            <span></span>
            <span></span>
            <span></span>
            <span></span>
          </div>
          <div class="attractor-bus"></div>
          <div class="attractor-newsbox"></div>
          <div class="attractor-crowd">
            <span class="person person--one"><i></i><b></b><em></em></span>
            <span class="person person--two"><i></i><b></b><em></em></span>
            <span class="person person--three"><i></i><b></b><em></em></span>
            <span class="person person--four"><i></i><b></b><em></em></span>
          </div>
          <div class="attractor-balloon-cluster attractor-balloon-cluster--one">
            <i></i><i></i><i></i>
          </div>
          <div class="attractor-balloon-cluster attractor-balloon-cluster--two">
            <i></i><i></i><i></i>
          </div>
        </div>
      </div>
    </section>

    <nav class="memory-rail" aria-labelledby="memory-rail-title">
      <div class="memory-rail__header">
        <p class="kicker">Breeze morgue rail</p>
        <h2 id="memory-rail-title">Memory Rail</h2>
      </div>
      <div class="memory-rail__tokens">
        <button class="rail-token rail-token--threshold is-active" data-rail-target="threshold" type="button" aria-current="true">
          <span class="rail-token__stamp">Start</span>
          <strong>Threshold</strong>
        </button>
        <button class="rail-token rail-token--years" data-rail-target="walk-years" type="button">
          <span class="rail-token__stamp">Hall</span>
          <strong>Memory Corridor</strong>
        </button>
        <button class="rail-token rail-token--friction" data-rail-target="friction-map" type="button">
          <span class="rail-token__stamp">Strings</span>
          <strong>Follow the Strings</strong>
        </button>
        <button class="rail-token rail-token--drawer" data-rail-target="open-drawer" type="button">
          <span class="rail-token__stamp">Drawer</span>
          <strong>Open the Drawer</strong>
        </button>
        <button class="rail-token rail-token--editor" data-rail-target="editor-game" type="button">
          <span class="rail-token__stamp">Desk</span>
          <strong>Editor’s Table</strong>
        </button>
        <button class="rail-token rail-token--reflection" data-rail-target="reflection-wall" type="button">
          <span class="rail-token__stamp">Wall</span>
          <strong>Reflection Wall</strong>
        </button>
        <button class="rail-token rail-token--class" id="class-tray-toggle" type="button" aria-expanded="false" aria-controls="class-tray">
          <span class="rail-token__stamp">Years</span>
          <strong>Class of…</strong>
        </button>
      </div>
      <div class="class-tray" id="class-tray" hidden aria-labelledby="class-tray-title">
        <p class="class-tray__title" id="class-tray-title">Class of…</p>
        <label class="class-tray__label" for="class-year">Show my four JMU years</label>
        <input id="class-year" type="range" min="1991" max="2026" value="2004" step="1" />
        <output class="class-tray__window" id="class-year-output" for="class-year">Class of 2004: 2001–2004</output>
        <div class="class-tray__buttons">
          <button class="class-tray__step" id="class-year-back" type="button" aria-label="Choose previous class year">−</button>
          <button class="class-tray__go" id="class-year-go" type="button">Show my four JMU years</button>
          <button class="class-tray__step" id="class-year-forward" type="button" aria-label="Choose next class year">+</button>
        </div>
        <button class="class-tray__clear" id="class-year-clear" type="button">Show all years</button>
      </div>
    </nav>

    <main class="exhibit-shell" id="top">
      <section class="threshold" id="threshold" data-chapter="threshold" aria-labelledby="threshold-title">
        <div class="threshold__paper" aria-hidden="true"></div>
        <p class="kicker">The Breeze archive / Darts & Pats / 1991–2026</p>
        <h1 id="threshold-title">The Breeze Between Town and Gown</h1>
        <p class="threshold__lede">
          Walk through Darts & Pats from <em>The Breeze</em> to explore tensions and ties between JMU and Harrisonburg/Rockingham. Touch floor tiles, doors, drawers, bulletin pins, and newspaper cards to open the archive.
        </p>
        <div class="threshold__actions">
          <button class="button button--primary button--kiosk-enter" id="kiosk-enter" type="button">Tap to enter the corridor</button>
          <a class="button button--ghost" href="#editor-game">Try the editor table</a>
        </div>
        <dl class="stat-strip" id="stat-strip" aria-live="polite">
          <div>
            <dt>Records</dt>
            <dd>616</dd>
          </div>
          <div>
            <dt>Darts</dt>
            <dd>373</dd>
          </div>
          <div>
            <dt>Pats</dt>
            <dd>243</dd>
          </div>
          <div>
            <dt>Years</dt>
            <dd>1991–2026</dd>
          </div>
        </dl>
      </section>

      <section class="curator-note" aria-labelledby="curator-title">
        <h2 id="curator-title">A public argument, one index card at a time</h2>
        <p>
          Darts and Pats are tiny letters, but together they expose a durable civic problem: shared space. Housing, crosswalks, buses, parties, storefronts, police, volunteers, and downtown life all become evidence of how campus and locality tug on each other.
        </p>
      </section>

      <section class="controls-panel" aria-label="Filter the exhibit">
        <div class="control-group">
          <label for="year-filter">Year</label>
          <select id="year-filter">
            <option value="all">All years</option>
          </select>
        </div>
        <div class="control-group">
          <label for="era-filter">Era</label>
          <select id="era-filter">
            <option value="all">All eras</option>
          </select>
        </div>
        <div class="control-group">
          <label for="topic-filter">Topic</label>
          <select id="topic-filter">
            <option value="all">All topics</option>
          </select>
        </div>
        <div class="control-group">
          <label for="kind-filter">Form</label>
          <select id="kind-filter">
            <option value="all">Darts and Pats</option>
            <option value="DART">Darts only</option>
            <option value="PAT">Pats only</option>
          </select>
        </div>
        <div class="control-group control-group--search">
          <label for="search-filter">Search text, entities, source</label>
          <input id="search-filter" type="search" placeholder="Try Main Street, bus, landlord, Mercy House…" />
        </div>
        <button class="button button--small" id="reset-filters" type="button">Reset</button>
        <button class="button button--small button--ghost" id="start-over" type="button">Start over</button>
        <button class="button button--small button--ghost" id="presentation-mode" type="button">Presentation Mode</button>
      </section>

      <section class="corridor" id="walk-years" data-chapter="walk-years" aria-labelledby="corridor-title">
        <div class="section-heading">
          <p class="kicker">2.5D corridor</p>
          <h2 id="corridor-title">The Memory Corridor</h2>
          <p id="corridor-subtitle">A quieter hallway of floor years, wall cards, and civic friction.</p>
          <button class="active-memory-chip" id="class-window-chip" type="button" hidden></button>
        </div>

        <aside class="word-breeze" id="word-breeze" aria-labelledby="word-breeze-title">
          <div>
            <p id="word-breeze-title">The archive is whispering about…</p>
          </div>
          <div class="word-breeze__cloud" id="word-breeze-cloud" aria-label="Words drifting through this view"></div>
          <div class="word-breeze__list" id="word-breeze-list" hidden aria-live="polite"></div>
        </aside>

        <div class="corridor-pan" id="corridor-pan" tabindex="0" aria-label="Swipe or drag sideways to walk through the corridor">
          <button class="corridor-edge-button corridor-edge-button--left" data-walk="left" type="button" aria-label="Walk left through the corridor">‹</button>
          <button class="corridor-edge-button corridor-edge-button--right" data-walk="right" type="button" aria-label="Walk right through the corridor">›</button>
          <div class="corridor-stage" aria-live="polite" data-corridor-stage>
            <div class="corridor-stage__ceiling" aria-hidden="true"></div>
            <div class="corridor-stage__vanish" aria-hidden="true"></div>
            <aside class="wall wall--left" aria-label="Darts wall">
              <div class="wall__label">
                <span aria-hidden="true">🎯</span>
                <strong>Darts wall</strong>
                <small>Sharp notes, civic static</small>
              </div>
              <div class="card-rack" id="dart-rack"></div>
            </aside>
            <div class="corridor-center">
              <div class="back-wall">
                <p class="kicker">Current view</p>
                <h3 id="current-view-title">All town-gown Darts & Pats</h3>
                <p id="current-view-summary">Loading the archive…</p>
                <div class="view-meters" id="view-meters"></div>
                <div class="featured-cards" id="featured-cards" aria-label="Featured cards from this corridor view"></div>
                <a class="button button--small button--ghost back-wall__drawer-link" href="#open-drawer">Open the full drawer</a>
              </div>
              <div class="corridor-walkway">
                <div class="trouble-spots" id="trouble-spots" aria-label="Topic stations">
                  <div class="topic-doors" id="topic-doors" aria-label="Topic doors and stations"></div>
                </div>
                <div class="floor-run" aria-labelledby="floor-title">
                  <div class="floor-run__header">
                    <div>
                      <p class="kicker" id="floor-title">Timeline floor</p>
                      <p>Step across yearly tiles. Darker means more Darts, warmer means more Pats, split tiles mean the town-gown mood could not pick a lane.</p>
                    </div>
                    <div class="floor-key" aria-label="Timeline mood key">
                      <span><i class="key key--dart"></i> Dart-heavy</span>
                      <span><i class="key key--mixed"></i> Mixed</span>
                      <span><i class="key key--pat"></i> Pat-heavy</span>
                    </div>
                  </div>
                  <div class="floor-timeline" id="floor-timeline" aria-label="Timeline floor from 1991 to 2026"></div>
                </div>
              </div>
            </div>
            <aside class="wall wall--right" aria-label="Pats wall">
              <div class="wall__label">
                <span aria-hidden="true">🤲</span>
                <strong>Pats wall</strong>
                <small>Warm notes, public thanks</small>
              </div>
              <div class="card-rack" id="pat-rack"></div>
            </aside>
          </div>
        </div>
      </section>

      <section class="network-section" id="friction-map" data-chapter="friction-map" aria-labelledby="network-title">
        <div class="section-heading">
          <p class="kicker">Corkboard room</p>
          <h2 id="network-title">Follow the Strings</h2>
          <p>This room has its own logic: tap a theme to recenter the board, tap a Dart or Pat clipping to open the drawer, or explicitly send a theme back to the Memory Corridor.</p>
        </div>
        <div class="string-room-actions" aria-label="Follow the Strings actions">
          <button class="button button--small button--ghost" id="return-corridor" type="button">Return to Memory Corridor</button>
          <details class="send-corridor" id="send-corridor">
            <summary>Send to corridor</summary>
            <div class="send-corridor__actions">
              <button class="button button--small button--ghost" id="use-string-theme" type="button">Also show this theme in the corridor</button>
              <button class="button button--small button--ghost" id="clear-string-theme" type="button">Clear corridor theme</button>
            </div>
          </details>
        </div>
        <div class="network-board string-board" id="network-board">
          <svg id="network-edges" aria-hidden="true"></svg>
          <div class="string-board__summary" id="string-summary"></div>
          <div id="network-nodes"></div>
          <div class="string-years" id="string-years" aria-label="Years represented in this string-board view"></div>
        </div>
      </section>

      <section class="reader-section" id="open-drawer" data-chapter="open-drawer" aria-labelledby="reader-title">
        <div class="section-heading">
          <p class="kicker">Reading drawer</p>
          <h2 id="reader-title">Open the Drawer</h2>
          <p>Every card opens into the original text. The exhibit works best when the data visualization sends people back to the words.</p>
        </div>
        <div class="shelf" id="reading-shelf"></div>
      </section>

      <section class="editor-game" id="editor-game" data-chapter="editor-game" aria-labelledby="editor-game-title">
        <div class="section-heading">
          <p class="kicker">No-score interpretive game</p>
          <h2 id="editor-game-title">You be the Breeze editor</h2>
          <p>Read a hidden card, guess whether it was a Dart or Pat, then reveal how it appeared and where it fits in the exhibit.</p>
        </div>
        <div class="game-card">
          <p class="game-pool-note" id="game-pool-note">Some cards are held out or masked because they give away their own form.</p>
          <blockquote id="game-text">Loading a card…</blockquote>
          <div class="game-fieldset" aria-label="Editor guesses">
            <fieldset>
              <legend>Form</legend>
              <div class="segmented">
                <button class="button button--small button--ghost" data-guess="DART" type="button" aria-pressed="false">Dart</button>
                <button class="button button--small button--ghost" data-guess="PAT" type="button" aria-pressed="false">Pat</button>
              </div>
            </fieldset>
            <div class="control-group">
              <label for="game-topic-guess">Topic</label>
              <select id="game-topic-guess">
                <option value="">Choose a topic</option>
              </select>
            </div>
          </div>
          <div class="game-controls">
            <button class="button button--small" id="reveal-game-card" type="button" disabled>Reveal the archive card</button>
            <button class="button button--small button--ghost" id="new-game-card" type="button">New card</button>
          </div>
          <p class="game-result" id="game-result" aria-live="polite"></p>
          <div class="game-related" id="game-related" aria-live="polite"></div>
        </div>
      </section>

      <section class="source-note reflection-wall" id="reflection-wall" data-chapter="reflection-wall" aria-labelledby="source-title">
        <p class="kicker">Reflection wall</p>
        <h2 id="source-title">What the wall remembers</h2>
        <p>
          All entries are drawn from Darts & Pats published in <em>The Breeze</em>, James Madison University’s student newspaper. They are presented as historical evidence of perception, humor, grievance, gratitude, and civic memory—not as neutral measurements of the town-gown relationship.
        </p>
      </section>
    </main>

    <div class="idle-overlay" id="idle-overlay" hidden role="status" aria-live="assertive">
      <div>
        <p class="kicker" id="idle-overlay-title">Kiosk reset</p>
        <strong id="idle-overlay-message">Returning to The Breeze Parade…</strong>
      </div>
    </div>

    <dialog class="record-drawer" id="record-drawer" aria-labelledby="drawer-title">
      <form method="dialog" class="drawer-close-form">
        <button class="drawer-close" value="close" aria-label="Close card">×</button>
      </form>
      <article id="drawer-content"></article>
    </dialog>

    <script type="module" src="/scripts/exhibit.js"></script>
  </body>
</html>
